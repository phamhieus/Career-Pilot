# --- Server ---
PORT=4000
# Comma-separated origins allowed for CORS in production (dev uses the Vite proxy)
APP_ORIGIN=http://localhost:5173

# Secret used to encrypt API keys users save in Settings (required in production;
# a random dev key is generated in .data/app-secret when unset).
APP_SECRET=

# --- Database ---
# PostgreSQL connection string. When unset, an embedded PGlite (Postgres-in-WASM)
# database is stored under PGLITE_DATA_DIR - convenient for local development only.
DATABASE_URL=postgres://careerpilot:careerpilot@localhost:5432/careerpilot
PGLITE_DATA_DIR=.data/pglite

# --- AI (one centralized service; OpenAI-compatible chat completions) ---
# Server default. Each user can also choose a provider and paste their own key in Settings.
# AI_PROVIDER: openai | deepseek | openai-compatible | none
AI_PROVIDER=deepseek
AI_API_KEY=
# Optional overrides (defaults: openai -> https://api.openai.com/v1, gpt-4.1-mini;
#                              deepseek -> https://api.deepseek.com/v1, deepseek-chat)
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# --- Job sources ---
CERT_TRENDS_BASE_URL=https://cert-chart.vercel.app/data
# Public company job-board APIs (comma-separated board tokens / company slugs)
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# Background sync interval in minutes (0 = disabled; use the "Sync now" button)
JOB_SYNC_INTERVAL_MINUTES=0
