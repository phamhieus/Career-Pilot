{
  "name": "careerpilot",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm start -w apps/api",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npx tsc -b apps/web",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "demo:rehearse": "node scripts/demo.mjs",
    "demo:auto": "node scripts/demo.mjs --auto",
    "demo:record": "node scripts/demo.mjs --record",
    "demo:seed-tracker": "node scripts/seed-demo-tracker.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
